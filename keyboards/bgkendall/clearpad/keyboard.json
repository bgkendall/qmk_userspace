{
    "keyboard_name": "Clearpad",
    "bootloader": "caterina",
    "build": {
        "lto": true
    },
    "debounce": 5,
    "diode_direction": "COL2ROW",
    "features": {
        "audio": false,
        "backlight": false,
        "bluetooth": false,
        "bootmagic": false,
        "bootmagic_lite": true,
        "command": false,
        "console": false,
        "encoder": false,
        "extrakey": true,
        "magic": false,
        "midi": false,
        "mousekey": true,
        "music": false,
        "nkro": false,
        "rgblight": true,
        "rgb_matrix": false,
        "unicode": false
    },
    "matrix_pins": {
        "direct": [
            ["F4"],
            ["F5"],
            ["F6"],
            ["F7"],
            ["B1"],
            ["B2"],
            ["B6"],
            ["D0"]
        ]
    },
    "processor": "atmega32u4",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x2320",
        "max_power": 100
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label":"TOGUP", "matrix": [5, 0], "y":0, "x":3},
                {"label":"TOGDN", "matrix": [6, 0], "y":1, "x":3},
                {"label":"UP",    "matrix": [0, 0], "y":3, "x":1},
                {"label":"LEFT",  "matrix": [1, 0], "y":4, "x":0},
                {"label":"MID",   "matrix": [3, 0], "y":4, "x":1},
                {"label":"RIGHT", "matrix": [2, 0], "y":4, "x":2},
                {"label":"DOWN",  "matrix": [4, 0], "y":5, "x":1},
                {"label":"RESET", "matrix": [7, 0], "y":5, "x":3}
            ]
        }
    },
    "rgblight": {
        "led_count": 6,
        "pin": "D3",
        "hue_steps": 10,
        "saturation_steps": 17,
        "brightness_steps": 17,
        "max_brightness": 34,
        "animations": {
            "all": false,
            "alternating": true,
            "breathing": true,
            "christmas": false,
            "knight": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "rgb_test": false,
            "snake": true,
            "static_gradient": true,
            "twinkle": false
        },
        "layers": {
            "enabled": true,
            "blink": true,
            "max": 4
        }
    },
    "ws2812": {
        "pin": "D3"
    }
}
